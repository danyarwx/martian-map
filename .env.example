# Copy to .env.local. Anything prefixed VITE_ ends up in the browser bundle, so it's public.
VITE_NASA_API_KEY=DEMO_KEY

# Server-only (no VITE_ prefix): used by the Vercel function api/tts.js for the OpenAI voice.
# Set these in the Vercel project settings, never in client code. Local testing needs `vercel dev`.
OPENAI_API_KEY=
# Optional overrides: OPENAI_TTS_MODEL (default gpt-4o-mini-tts), OPENAI_TTS_VOICE (default marin)
